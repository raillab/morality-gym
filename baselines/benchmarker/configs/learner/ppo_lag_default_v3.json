{
    "init": {
        "norm_reward": true,
        "cost_function_kwargs": {
            "scale_fact": 1.0,
            "information_mode": "minimal"
        },
        "device": "cpu",

        "n_vec_env": 8,
        "n_torch_threads": 7,

        "log_tensorboard": true,
        "save_model_freq": 1000000000,

        "deterministic_eval": false,

        "os_custom_cfgs": {
            "lagrange_cfgs": {
                "cost_limit": 0.0
            },
            "algo_cfgs": {
                "steps_per_epoch": 2048,
                "batch_size": 64,
                "entropy_coef": 0.0,
                "obs_normalize": false
            },
            "model_cfgs": {
                "linear_lr_decay": true,
                "actor": {
                    "lr": 0.0003
                },
                "critic": {
                    "lr": 0.0003
                }
            }
        }
    },
    "learn": {}
}